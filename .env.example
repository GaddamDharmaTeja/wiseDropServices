PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/wishdrop
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
PUBLIC_REVEAL_BASE_URL=http://localhost:3001/surprise
PUBLIC_API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
ADMIN_EMAIL=admin@wishdrop.local
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=WishDrop Admin

# On a phone, set these to your PC LAN IP, e.g.
# PUBLIC_API_BASE_URL=http://10.89.137.76:3001
# PUBLIC_REVEAL_BASE_URL=http://10.89.137.76:3001/surprise

# Web app URL used in password-reset emails (Expo web default port)
PUBLIC_APP_URL=http://localhost:8081

# Log password-reset links when SMTP is not set (local dev)
LOG_PASSWORD_RESET_LINKS=true

# Gmail example — use an App Password (Google Account → Security → App passwords), not your normal password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=paste-google-app-password-here-16-chars
# SMTP_FROM=WishDrop <you@gmail.com>

# Optional — enable when ready
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# EXPO_ACCESS_TOKEN=
